<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="pane" prefHeight="936.0" prefWidth="1498.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.itis.nightindvoika.controllers.OfficeController">
   <children>
      <ImageView fx:id="backgroundImageView" fitHeight="936.0" fitWidth="1498.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../../static/images/office/nomask/pic.png" />
         </image></ImageView>
      <Button fx:id="putOnMaskButton" layoutX="1261.0" layoutY="861.0" mnemonicParsing="false" onAction="#switchMaskMode" text="Надеть маску">
         <font>
            <Font size="26.0" />
         </font>
      </Button>
      <Button fx:id="camerasButton" layoutX="40.0" layoutY="861.0" mnemonicParsing="false" onAction="#openCameras" text="Камеры">
         <font>
            <Font size="26.0" />
         </font>
      </Button>
      <Button fx:id="menuButton" layoutX="39.0" layoutY="27.0" mnemonicParsing="false" onAction="#backToMenu" text="Меню">
         <font>
            <Font size="26.0" />
         </font>
      </Button>
      <Button fx:id="radarButton" layoutX="764.0" layoutY="861.0" mnemonicParsing="false" onAction="#activateRadar" text="Радар">
         <font>
            <Font size="26.0" />
         </font>
      </Button>
      <Text fx:id="text" fill="WHITE" layoutY="130.0" strokeType="OUTSIDE" strokeWidth="0.0" textAlignment="CENTER" wrappingWidth="1498.0">
         <font>
            <Font name="Arial" size="26.0" />
         </font>
      </Text>
      <Button fx:id="electricShockButton" layoutX="915.0" layoutY="861.0" mnemonicParsing="false" onAction="#activateElectricShock" text="Электро-шок">
         <font>
            <Font size="26.0" />
         </font>
      </Button>
      <Text fx:id="textTimer" fill="WHITE" layoutX="1383.0" layoutY="64.0" strokeType="OUTSIDE" strokeWidth="0.0" text="0 AM">
         <font>
            <Font size="26.0" />
         </font>
      </Text>
   </children>
</AnchorPane>
