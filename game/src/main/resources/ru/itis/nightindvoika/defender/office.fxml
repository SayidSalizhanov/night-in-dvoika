<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane fx:id="pane" prefHeight="720.0" prefWidth="1152.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.itis.nightindvoika.controllers.OfficeController">
   <children>
      <ImageView fx:id="backgroundImageView" fitHeight="720.0" fitWidth="1152.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../../static/images/office/nomask/pic.png" />
         </image></ImageView>
      <Button fx:id="putOnMaskButton" layoutX="970.0" layoutY="662.0" mnemonicParsing="false" onAction="#switchMaskMode" text="Надеть маску">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
      <Button fx:id="camerasButton" layoutX="31.0" layoutY="662.0" mnemonicParsing="false" onAction="#openCameras" text="Камеры">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
      <Button fx:id="menuButton" layoutX="30.0" layoutY="21.0" mnemonicParsing="false" onAction="#backToMenu" text="Меню">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
      <Button fx:id="radarButton" layoutX="588.0" layoutY="662.0" mnemonicParsing="false" onAction="#activateRadar" text="Радар">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
      <Text fx:id="text" fill="WHITE" layoutY="100.0" strokeType="OUTSIDE" strokeWidth="0.0" textAlignment="CENTER" wrappingWidth="1152.0">
         <font>
            <Font name="Arial" size="20.0" />
         </font>
      </Text>
      <Button fx:id="electricShockButton" layoutX="704.0" layoutY="662.0" mnemonicParsing="false" onAction="#activateElectricShock" text="Электро-шок">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
      <Button fx:id="refreshButton" layoutX="31.0" layoutY="93.0" mnemonicParsing="false" onAction="#refresh" text="Обновить">
         <font>
            <Font size="20.0" />
         </font>
      </Button>
      <Text fx:id="textTimer" fill="WHITE" layoutX="1064.0" layoutY="49.0" strokeType="OUTSIDE" strokeWidth="0.0" text="0 AM">
         <font>
            <Font size="20.0" />
         </font>
      </Text>
   </children>
</AnchorPane>
